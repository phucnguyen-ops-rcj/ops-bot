# Copy to .env and fill in values. Do NOT commit .env.
# Variables marked [ENV] should be exported in the shell or service manager.

# Signal
SIGNAL_BASE_URL="http://127.0.0.1:8081"
SIGNAL_SENDER="+1234567890"
SIGNAL_RECIPIENT=""              # optional fallback individual recipient
SIGNAL_GROUP_ID="group.xxx"      # optional fallback group id from GET /v1/groups/{number}
SIGNAL_BOT_RECEIVE_MODE="auto"   # auto, poll, or websocket
SIGNAL_BOT_POLL_SECONDS="2"

# RCJ ops API
RCJ_OPS_BASE_ENDPOINT="http://18.176.93.228"
RCJ_OPS_TIMEOUT_SECONDS="60"
RCJ_OPS_EXECUTION_MODE="local"   # local or ssh
RCJ_OPS_SSH_HOST="T1_newuser1"
# [ENV] export RCJ_OPS_BEARER_TOKEN="xxx"

# BAML/OpenAI extraction
# [ENV] export OPENAI_API_KEY="sk-xxx"

# Logging
LOG_LEVEL="INFO"
