# Copy to .env and fill in values. Do NOT commit .env.
# Variables marked [ENV] should be exported in the shell or service manager.

# Signal
SIGNAL_BASE_URL=http://127.0.0.1:8081
SIGNAL_SENDER=+1234567890
# Optional fallback individual recipient
SIGNAL_RECIPIENT=
# Optional fallback group id from GET /v1/groups/{number}
SIGNAL_GROUP_ID=group.xxx
SIGNAL_GROUP_CACHE_PATH=signal_groups.yml
# auto, poll, or websocket
SIGNAL_BOT_RECEIVE_MODE=auto
SIGNAL_BOT_POLL_SECONDS=2
# Group messages need one alias or a Signal mention
SIGNAL_BOT_MENTION_ALIASES=opsbot,@opsbot

# RCJ ops API
RCJ_OPS_BASE_ENDPOINT=http://18.176.93.228
RCJ_OPS_TIMEOUT_SECONDS=60
# local or ssh
RCJ_OPS_EXECUTION_MODE=local
RCJ_OPS_SSH_HOST=T1_newuser1
# [ENV] export RCJ_OPS_BEARER_TOKEN="xxx"

# Prefect server used by schedule commands. API URL must include /api.
PREFECT_API_URL=http://100.72.177.110:4200/api
# Must match PREFECT_SERVER_API_AUTH_STRING on an authenticated Prefect server.
PREFECT_API_AUTH_STRING=admin:change-me
PREFECT_UI_URL=http://100.72.177.110:4200
PREFECT_TIMEOUT_SECONDS=30
PREFECT_TIMEZONE=Asia/Singapore

# BAML/OpenAI extraction
# Used for commands that need parameter extraction. /health and /ping bypass BAML.
OPENAI_API_KEY=sk-xxx

# Logging
LOG_LEVEL=INFO
